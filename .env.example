# 이 파일을 .env로 복사한 뒤 값을 채워 넣으세요.
# 포크해서 다른 도메인에 배포할 때만 자신의 값으로 바꾸면 됩니다.
# (Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 발급, "승인된 JavaScript 원본"에
#  본인이 실제로 서빙할 도메인을 등록해야 합니다. 자세한 절차는 docs/SETUP.md 참고.)

VITE_GOOGLE_CLIENT_ID=

# Google Picker API용 API 키 (OAuth 클라이언트 ID와는 별개).
# Google Cloud Console > API 및 서비스 > 사용자 인증 정보에서 "API 키"를 새로 만들고,
# API 및 서비스 > 라이브러리에서 "Google Picker API"를 사용 설정해야 합니다.
# 워드뱅크 화면에서 "내 드라이브에서 파일 선택" 기능에만 쓰입니다.

VITE_GOOGLE_API_KEY=

# Google Picker의 setAppId에 필요한 값 — drive.file 스코프에서는 필수입니다.
# API 키가 아니라 "Cloud 프로젝트 번호"입니다 (Cloud Console 홈 화면 상단 "프로젝트 번호"에서 확인,
# 또는 IAM 및 관리 > 설정 페이지에서 확인). 이게 없으면 피커로 파일을 골라도
# 실제로는 그 파일에 접근 권한이 부여되지 않아 이후 읽기 시도가 실패합니다.

VITE_GOOGLE_APP_ID=
